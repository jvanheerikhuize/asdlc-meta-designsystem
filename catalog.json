{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "asdlc-meta-designsystem",
  "version": "0.1.0",
  "spec": "SPC-0001",
  "entrypoint": "src/index.js",
  "publishedEntrypoint": "https://jvanheerikhuize.github.io/asdlc-meta-designsystem/showcase/src/index.js",
  "entrypointExports": ["UiButton", "UiInput", "UiLabel", "UiBadge", "UiIcon", "UiSkeleton", "UiChip", "UiProgress", "UiTextarea", "UiSelect", "UiDot", "UiCheckbox", "UiField", "UiSearchBar", "UiMediaCard", "UiStatTile", "UiCallout", "UiCodeBlock", "UiNavbar", "UiModal", "UiCatalogGrid", "PageShell", "CatalogLayout", "DetailLayout", "TOKENS_URL", "ATOMS", "MOLECULES", "ORGANISMS", "TEMPLATES", "ensureTokens(doc = document)"],
  "tokensStylesheet": "src/tokens/tokens.css",
  "publishedTokensUrl": "https://jvanheerikhuize.github.io/asdlc-meta-designsystem/showcase/src/tokens/tokens.css",
  "tokensScope": "Defines CSS custom properties on :root and [data-theme='light'] plus reduced-motion rules; does not style body or bundle @font-face files.",
  "architecture": {
    "tiers": ["tokens", "atoms", "molecules", "organisms", "templates", "pages"],
    "rule": "Unidirectional dependencies only: lower tiers MUST NOT import or depend on higher tiers."
  },
  "themes": {
    "default": "dark (:root)",
    "light": "[data-theme=\"light\"]"
  },
  "tokens": {
    "canvasAndSurfaces": [
      { "name": "--color-bg", "dark": "#08080b", "light": "#fafafa", "role": "Primary page canvas" },
      { "name": "--color-surface", "dark": "#111116", "light": "#ffffff", "role": "Elevated container surface" },
      { "name": "--color-surface-elevated", "dark": "#18181f", "light": "#f4f4f5", "role": "Higher elevation surface" },
      { "name": "--color-card", "dark": "rgba(255, 255, 255, 0.04)", "light": "rgba(9, 9, 11, 0.03)", "role": "Translucent card surface" },
      { "name": "--color-card-hover", "dark": "rgba(255, 255, 255, 0.07)", "light": "rgba(9, 9, 11, 0.06)", "role": "Translucent card hover surface" },
      { "name": "--color-overlay", "dark": "rgba(0, 0, 0, 0.75)", "light": "rgba(9, 9, 11, 0.55)", "role": "Modal/dialog backdrop" }
    ],
    "ambientGlow": [
      { "name": "--glow-rose", "dark": "rgba(244, 63, 94, 0.08)", "light": "rgba(225, 29, 72, 0.06)", "role": "Top ambient rose highlight" },
      { "name": "--glow-amber", "dark": "rgba(251, 146, 60, 0.05)", "light": "rgba(217, 119, 6, 0.04)", "role": "Secondary ambient amber highlight" }
    ],
    "borders": [
      { "name": "--color-border", "dark": "rgba(255, 255, 255, 0.08)", "light": "rgba(9, 9, 11, 0.10)", "role": "Default hairline border" },
      { "name": "--color-border-hover", "dark": "rgba(255, 255, 255, 0.22)", "light": "rgba(9, 9, 11, 0.24)", "role": "Hover/active hairline border" },
      { "name": "--color-focus-ring", "dark": "#f43f5e", "light": "#e11d48", "role": "Keyboard focus outline" }
    ],
    "foreground": [
      { "name": "--color-fg", "dark": "#ededed", "light": "#09090b", "role": "Primary text" },
      { "name": "--color-fg-secondary", "dark": "#a1a1aa", "light": "#52525b", "role": "Secondary text" },
      { "name": "--color-fg-muted", "dark": "#8e8e98", "light": "#5c5c66", "role": "Muted/caption text" }
    ],
    "accents": [
      { "name": "--color-accent", "dark": "#f43f5e", "light": "#e11d48", "role": "Primary brand accent" },
      { "name": "--color-accent-hover", "dark": "#fb7185", "light": "#be123c", "role": "Primary brand accent hover" },
      { "name": "--color-accent-fg", "dark": "#08080b", "light": "#ffffff", "role": "Text on --color-accent" },
      { "name": "--color-info", "dark": "#38bdf8", "light": "#0369a1", "role": "Informational status" },
      { "name": "--color-success", "dark": "#10b981", "light": "#047857", "role": "Success status" },
      { "name": "--color-warning", "dark": "#f59e0b", "light": "#b45309", "role": "Warning status" },
      { "name": "--color-danger", "dark": "#f87171", "light": "#dc2626", "role": "Danger/error status" },
      { "name": "--color-danger-fg", "dark": "#08080b", "light": "#ffffff", "role": "Text on --color-danger" }
    ],
    "typography": [
      { "name": "--font-sans", "value": "'Geist', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "role": "Body sans-serif stack" },
      { "name": "--font-display", "value": "'Bricolage Grotesque', 'Geist', system-ui, sans-serif", "role": "Display heading stack" },
      { "name": "--font-mono", "value": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", "role": "Monospace stack" },
      { "name": "--text-xs", "value": "0.75rem", "role": "Extra-small type" },
      { "name": "--text-sm", "value": "0.875rem", "role": "Small type" },
      { "name": "--text-md", "value": "1rem", "role": "Base type" },
      { "name": "--text-lg", "value": "1.125rem", "role": "Large type" },
      { "name": "--text-xl", "value": "1.375rem", "role": "Extra-large type" },
      { "name": "--text-2xl", "value": "1.875rem", "role": "Display type" },
      { "name": "--leading-tight", "value": "1.2", "role": "Tight line height" },
      { "name": "--leading-normal", "value": "1.5", "role": "Normal line height" }
    ],
    "spacing": [
      { "name": "--space-1", "value": "0.25rem" },
      { "name": "--space-2", "value": "0.5rem" },
      { "name": "--space-3", "value": "0.75rem" },
      { "name": "--space-4", "value": "1rem" },
      { "name": "--space-5", "value": "1.25rem" },
      { "name": "--space-6", "value": "1.5rem" },
      { "name": "--space-8", "value": "2rem" },
      { "name": "--space-10", "value": "2.5rem" },
      { "name": "--space-12", "value": "3rem" }
    ],
    "radii": [
      { "name": "--radius-sm", "value": "0.375rem" },
      { "name": "--radius-md", "value": "0.5rem" },
      { "name": "--radius-lg", "value": "0.75rem" },
      { "name": "--radius-xl", "value": "1rem" },
      { "name": "--radius-full", "value": "9999px" }
    ],
    "shadows": [
      { "name": "--shadow-sm", "dark": "0 1px 2px rgba(0, 0, 0, 0.35)", "light": "0 1px 2px rgba(9, 9, 11, 0.06)" },
      { "name": "--shadow-md", "dark": "0 4px 14px rgba(0, 0, 0, 0.45)", "light": "0 4px 14px rgba(9, 9, 11, 0.08)" },
      { "name": "--shadow-lg", "dark": "0 12px 32px rgba(0, 0, 0, 0.6)", "light": "0 12px 32px rgba(9, 9, 11, 0.12)" }
    ],
    "motion": [
      { "name": "--duration-fast", "value": "120ms", "reducedMotion": "0ms" },
      { "name": "--duration-normal", "value": "220ms", "reducedMotion": "0ms" },
      { "name": "--duration-shimmer", "value": "1400ms", "reducedMotion": "0ms" },
      { "name": "--ease-standard", "value": "cubic-bezier(0.2, 0.8, 0.2, 1)" }
    ]
  },
  "components": [
    {
      "tag": "ui-button",
      "tier": "atoms",
      "module": "src/atoms/ui-button.js",
      "className": "UiButton",
      "description": "Interactive button Atom encapsulating native <button> with variant, size, disabled, and busy states.",
      "attributes": {
        "variant": { "type": "enum", "values": ["primary", "secondary", "ghost", "danger"], "default": "primary" },
        "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "md" },
        "disabled": { "type": "boolean", "default": false },
        "busy": { "type": "boolean", "default": false },
        "type": { "type": "enum", "values": ["button", "submit", "reset"], "default": "button" },
        "aria-label": { "type": "string", "default": null }
      },
      "slots": ["default"],
      "events": [
        { "name": "ui-press", "detail": { "variant": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["button"],
      "accessibility": "Uses Shadow DOM delegatesFocus: true over native <button>. Suppresses click/keyboard activation and sets aria-disabled='true' when disabled or busy; sets aria-busy='true' when busy; displays visible :focus-visible ring.",
      "example": "<ui-button variant=\"primary\" size=\"md\">Save Changes</ui-button>"
    },
    {
      "tag": "ui-input",
      "tier": "atoms",
      "module": "src/atoms/ui-input.js",
      "className": "UiInput",
      "description": "Text input Atom encapsulating native <input> with reactive value and validation state.",
      "attributes": {
        "type": { "type": "string", "default": "text" },
        "value": { "type": "string", "default": "" },
        "placeholder": { "type": "string", "default": "" },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "required": { "type": "boolean", "default": false },
        "invalid": { "type": "boolean", "default": false },
        "name": { "type": "string", "default": "" },
        "aria-label": { "type": "string", "default": null }
      },
      "slots": [],
      "events": [
        { "name": "ui-input", "detail": { "value": "string" }, "bubbles": true, "composed": true },
        { "name": "ui-change", "detail": { "value": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["input"],
      "accessibility": "Uses delegatesFocus: true over native <input>. Syncs aria-invalid from the invalid attribute and forwards aria-label.",
      "example": "<ui-input type=\"email\" placeholder=\"name@example.com\" required></ui-input>"
    },
    {
      "tag": "ui-label",
      "tier": "atoms",
      "module": "src/atoms/ui-label.js",
      "className": "UiLabel",
      "description": "Form label Atom with optical cap-height alignment and optional required indicator.",
      "attributes": {
        "for": { "type": "string", "default": null },
        "required": { "type": "boolean", "default": false },
        "size": { "type": "enum", "values": ["md", "sm"], "default": "md" }
      },
      "slots": ["default"],
      "events": [],
      "parts": ["label"],
      "accessibility": "Renders a native <label> inside Shadow DOM; marks the visual asterisk aria-hidden='true'.",
      "example": "<ui-label for=\"email\" required>Email Address</ui-label>"
    },
    {
      "tag": "ui-badge",
      "tier": "atoms",
      "module": "src/atoms/ui-badge.js",
      "className": "UiBadge",
      "description": "Status and metadata pill badge Atom.",
      "attributes": {
        "variant": { "type": "enum", "values": ["neutral", "accent", "info", "success", "warning"], "default": "neutral" },
        "size": { "type": "enum", "values": ["sm", "md"], "default": "sm" }
      },
      "slots": ["default"],
      "events": [],
      "parts": ["badge"],
      "accessibility": "Non-interactive inline status indicator; pair with clear text content.",
      "example": "<ui-badge variant=\"success\">active</ui-badge>"
    },
    {
      "tag": "ui-icon",
      "tier": "atoms",
      "module": "src/atoms/ui-icon.js",
      "className": "UiIcon",
      "description": "Built-in vector icon Atom.",
      "attributes": {
        "name": { "type": "enum", "values": ["search", "sun", "moon", "check", "alert", "info", "arrow-right", "arrow-left", "sparkles", "code", "layers", "external"], "default": "sparkles" },
        "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "md" },
        "label": { "type": "string", "default": null }
      },
      "slots": [],
      "events": [],
      "parts": ["icon"],
      "accessibility": "Decorative by default (aria-hidden='true'). When label is provided, exposes role='img' and aria-label.",
      "example": "<ui-icon name=\"sparkles\" size=\"md\" label=\"Featured\"></ui-icon>"
    },
    {
      "tag": "ui-skeleton",
      "tier": "atoms",
      "module": "src/atoms/ui-skeleton.js",
      "className": "UiSkeleton",
      "description": "Loading placeholder Atom with shimmer animation and reduced-motion static fallback.",
      "attributes": {
        "variant": { "type": "enum", "values": ["text", "rect", "circle"], "default": "text" },
        "width": { "type": "string", "default": "100%" },
        "height": { "type": "string", "default": "1rem" },
        "lines": { "type": "number", "default": 1 }
      },
      "slots": [],
      "events": [],
      "parts": ["skeleton"],
      "accessibility": "Sets aria-busy='true' on the host and aria-hidden='true' on visual shimmer bones; disables shimmer under prefers-reduced-motion: reduce.",
      "example": "<ui-skeleton variant=\"text\" lines=\"3\"></ui-skeleton>"
    },
    {
      "tag": "ui-field",
      "tier": "molecules",
      "module": "src/molecules/ui-field.js",
      "className": "UiField",
      "description": "Form field Molecule composing <ui-label>, <ui-input>, and hint/error text.",
      "attributes": {
        "label": { "type": "string", "default": "" },
        "name": { "type": "string", "default": "" },
        "value": { "type": "string", "default": "" },
        "placeholder": { "type": "string", "default": "" },
        "type": { "type": "string", "default": "text" },
        "required": { "type": "boolean", "default": false },
        "invalid": { "type": "boolean", "default": false },
        "disabled": { "type": "boolean", "default": false },
        "hint": { "type": "string", "default": "" },
        "error": { "type": "string", "default": "" }
      },
      "slots": [],
      "events": [
        { "name": "ui-input", "detail": { "value": "string" }, "bubbles": true, "composed": true },
        { "name": "ui-change", "detail": { "value": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["label", "input", "hint"],
      "accessibility": "Forwards label to aria-label on inner <ui-input> and exposes .value JS property.",
      "example": "<ui-field label=\"Project\" placeholder=\"asdlc-meta-designsystem\" required></ui-field>"
    },
    {
      "tag": "ui-search-bar",
      "tier": "molecules",
      "module": "src/molecules/ui-search-bar.js",
      "className": "UiSearchBar",
      "description": "Search bar Molecule composing <ui-input>, <ui-button>, and <ui-icon>.",
      "attributes": {
        "value": { "type": "string", "default": "" },
        "placeholder": { "type": "string", "default": "Search…" },
        "button-label": { "type": "string", "default": "Search" },
        "aria-label": { "type": "string", "default": "Search" },
        "disabled": { "type": "boolean", "default": false }
      },
      "slots": [],
      "events": [
        { "name": "ui-search", "detail": { "query": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["bar", "input", "button"],
      "accessibility": "Wraps controls in role='search' and emits ui-search on Enter or button activation.",
      "example": "<ui-search-bar placeholder=\"Filter catalog…\"></ui-search-bar>"
    },
    {
      "tag": "ui-media-card",
      "tier": "molecules",
      "module": "src/molecules/ui-media-card.js",
      "className": "UiMediaCard",
      "description": "Interactive translucent catalog/poster card Molecule composing <ui-badge> and <ui-icon>.",
      "attributes": {
        "card-id": { "type": "string", "default": "" },
        "title": { "type": "string", "default": "" },
        "subtitle": { "type": "string", "default": "" },
        "badge": { "type": "string", "default": "" },
        "badge-variant": { "type": "enum", "values": ["neutral", "accent", "info", "success", "warning"], "default": "neutral" },
        "meta": { "type": "string", "default": "" }
      },
      "slots": ["default"],
      "events": [
        { "name": "ui-select", "detail": { "id": "string", "title": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["card", "badge", "title", "subtitle", "meta"],
      "accessibility": "Uses native <button> with delegatesFocus: true and visible :focus-visible outline.",
      "example": "<ui-media-card card-id=\"item-1\" title=\"Token Set\" subtitle=\"Dark-first palette\" badge=\"active\" badge-variant=\"success\"></ui-media-card>"
    },
    {
      "tag": "ui-navbar",
      "tier": "organisms",
      "module": "src/organisms/ui-navbar.js",
      "className": "UiNavbar",
      "description": "Sticky frosted-glass site header Organism with integrated theme toggle.",
      "attributes": {
        "theme": { "type": "enum", "values": ["dark", "light"], "default": "dark" }
      },
      "slots": ["brand", "nav", "search", "actions"],
      "events": [
        { "name": "ui-theme-change", "detail": { "theme": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["header", "theme-button"],
      "accessibility": "Wraps navigation slot in <nav aria-label='Primary'>.",
      "example": "<ui-navbar><a slot=\"brand\" href=\"./\">ASDLC</a></ui-navbar>"
    },
    {
      "tag": "ui-modal",
      "tier": "organisms",
      "module": "src/organisms/ui-modal.js",
      "className": "UiModal",
      "description": "Modal dialog Organism built on native <dialog> with blurred backdrop and focus restoration.",
      "attributes": {
        "title": { "type": "string", "default": "" },
        "open": { "type": "boolean", "default": false }
      },
      "slots": ["default", "footer"],
      "events": [
        { "name": "ui-open", "detail": {}, "bubbles": true, "composed": true },
        { "name": "ui-close", "detail": { "reason": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["dialog", "title", "close", "body", "footer"],
      "accessibility": "Uses native <dialog>.showModal() for top-layer focus containment, Escape/backdrop dismissal, and focus restoration to the triggering element.",
      "example": "<ui-modal title=\"Item Details\"><p>Details here.</p></ui-modal>"
    },
    {
      "tag": "ui-catalog-grid",
      "tier": "organisms",
      "module": "src/organisms/ui-catalog-grid.js",
      "className": "UiCatalogGrid",
      "description": "Responsive grid Organism for <ui-media-card> items with loading skeletons and empty state.",
      "attributes": {
        "loading": { "type": "boolean", "default": false },
        "empty": { "type": "boolean", "default": false },
        "empty-text": { "type": "string", "default": "No matching items." }
      },
      "slots": ["default"],
      "events": [],
      "parts": ["skeletons", "grid", "empty"],
      "accessibility": "Renders responsive CSS grid with clear empty-state text.",
      "example": "<ui-catalog-grid empty-text=\"No matches\"></ui-catalog-grid>"
    },
    {
      "tag": "page-shell",
      "tier": "templates",
      "module": "src/templates/page-shell.js",
      "className": "PageShell",
      "description": "Full-page structural Template with header, main, and footer slots.",
      "attributes": {},
      "slots": ["header", "default", "footer"],
      "events": [],
      "parts": ["main", "footer"],
      "accessibility": "Provides semantic <main> and <footer> landmarks.",
      "example": "<page-shell><ui-navbar slot=\"header\"></ui-navbar><p>Content</p></page-shell>"
    },
    {
      "tag": "catalog-layout",
      "tier": "templates",
      "module": "src/templates/catalog-layout.js",
      "className": "CatalogLayout",
      "description": "Catalog browser Template arranging hero, toolbar, grid, and modal slots.",
      "attributes": {},
      "slots": ["hero", "toolbar", "grid", "modal"],
      "events": [],
      "parts": ["hero", "toolbar", "grid"],
      "accessibility": "Structures catalog sections in semantic <section> landmarks.",
      "example": "<catalog-layout><div slot=\"hero\">...</div><ui-catalog-grid slot=\"grid\"></ui-catalog-grid></catalog-layout>"
    },
    {
      "tag": "ui-chip",
      "tier": "atoms",
      "module": "src/atoms/ui-chip.js",
      "className": "UiChip",
      "description": "Toggleable filter pill Atom with pressed state and ui-toggle event.",
      "attributes": {
        "pressed": { "type": "boolean", "default": false },
        "disabled": { "type": "boolean", "default": false },
        "variant": { "type": "enum", "values": ["default", "accent"], "default": "default" }
      },
      "slots": ["default"],
      "events": [
        { "name": "ui-toggle", "detail": { "pressed": "boolean" }, "bubbles": true, "composed": true }
      ],
      "parts": ["chip"],
      "accessibility": "Uses delegatesFocus: true over native <button> with aria-pressed synchronization.",
      "example": "<ui-chip pressed>active</ui-chip>"
    },
    {
      "tag": "ui-progress",
      "tier": "atoms",
      "module": "src/atoms/ui-progress.js",
      "className": "UiProgress",
      "description": "Progress/readiness bar Atom with semantic color variants.",
      "attributes": {
        "value": { "type": "number", "default": 0 },
        "max": { "type": "number", "default": 100 },
        "variant": { "type": "enum", "values": ["success", "accent", "warning", "danger"], "default": "success" },
        "aria-label": { "type": "string", "default": null }
      },
      "slots": [],
      "events": [],
      "parts": ["track", "fill"],
      "accessibility": "Exposes role='progressbar' with aria-valuenow, aria-valuemin, and aria-valuemax.",
      "example": "<ui-progress value=\"80\" aria-label=\"Readiness\"></ui-progress>"
    },
    {
      "tag": "ui-textarea",
      "tier": "atoms",
      "module": "src/atoms/ui-textarea.js",
      "className": "UiTextarea",
      "description": "Multi-line text input Atom encapsulating native <textarea>.",
      "attributes": {
        "value": { "type": "string", "default": "" },
        "placeholder": { "type": "string", "default": "" },
        "rows": { "type": "number", "default": 3 },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "required": { "type": "boolean", "default": false },
        "invalid": { "type": "boolean", "default": false },
        "name": { "type": "string", "default": "" },
        "aria-label": { "type": "string", "default": null }
      },
      "slots": [],
      "events": [
        { "name": "ui-input", "detail": { "value": "string" }, "bubbles": true, "composed": true },
        { "name": "ui-change", "detail": { "value": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["textarea"],
      "accessibility": "Uses delegatesFocus: true over native <textarea> and syncs aria-invalid.",
      "example": "<ui-textarea aria-label=\"Statement\" rows=\"3\" placeholder=\"Describe behaviour…\"></ui-textarea>"
    },
    {
      "tag": "ui-select",
      "tier": "atoms",
      "module": "src/atoms/ui-select.js",
      "className": "UiSelect",
      "description": "Native <select> Atom driven by JSON options attribute/property.",
      "attributes": {
        "options": { "type": "json", "default": "[]" },
        "value": { "type": "string", "default": "" },
        "disabled": { "type": "boolean", "default": false },
        "invalid": { "type": "boolean", "default": false },
        "name": { "type": "string", "default": "" },
        "aria-label": { "type": "string", "default": null }
      },
      "slots": [],
      "events": [
        { "name": "ui-change", "detail": { "value": "string" }, "bubbles": true, "composed": true }
      ],
      "parts": ["select"],
      "accessibility": "Uses delegatesFocus: true over native <select> and syncs aria-invalid.",
      "example": "<ui-select aria-label=\"Status\" options='[\"open\",\"active\"]'></ui-select>"
    },
    {
      "tag": "ui-dot",
      "tier": "atoms",
      "module": "src/atoms/ui-dot.js",
      "className": "UiDot",
      "description": "Semantic status dot Atom (done, wait, bad, info, off).",
      "attributes": {
        "status": { "type": "enum", "values": ["done", "wait", "bad", "info", "off"], "default": "off" },
